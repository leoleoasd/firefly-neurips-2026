+def _log_pool_stats(client: httpx.AsyncClient) -> str:
+    """Return a one-line summary of the httpcore connection pool state."""
+    try:
+        pool = client._transport._pool
+        conns = pool.connections
+        total = len(conns)
+        idle = sum(1 for c in conns if c.is_idle())
+        closed = sum(1 for c in conns if c.is_closed())
+        in_use = total - idle - closed
+        queued = len([r for r in pool._requests if r.is_queued()])
+        return f"pool: total={total} in_use={in_use} idle={idle} closed={closed} queued={queued} max={pool._max_connections}"
+    except Exception as e:
+        return f"pool: error reading stats: {e}"
+
