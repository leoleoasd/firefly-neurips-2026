{"index": 7, "metadata": {"task_description": "Translate 'Hello, how are you?' to Spanish, French, and Japanese.", "answer_schema": {"spanish": "<Spanish translation>", "french": "<French translation>", "japanese": "<Japanese translation>"}, "tools": [{"type": "function", "function": {"name": "translate", "description": "Translate text to a target language", "parameters": {"type": "object", "properties": {"text": {"type": "string", "description": "Text to translate"}, "target_language": {"type": "string", "description": "Target language code (e.g., es, fr, ja)"}}, "required": ["text", "target_language"]}}}], "expected_answer": {"spanish": "Hola, ¿cómo estás?", "french": "Bonjour, comment allez-vous?", "japanese": "こんにちは、お元気ですか？"}, "ground_truth_trajectory": [{"tool_name": "translate", "tool_input": {"text": "Hello, how are you?", "target_language": "es"}, "tool_output": "{\"translated_text\": \"Hola, ¿cómo estás?\"}"}, {"tool_name": "translate", "tool_input": {"text": "Hello, how are you?", "target_language": "fr"}, "tool_output": "{\"translated_text\": \"Bonjour, comment allez-vous?\"}"}, {"tool_name": "translate", "tool_input": {"text": "Hello, how are you?", "target_language": "ja"}, "tool_output": "{\"translated_text\": \"こんにちは、お元気ですか？\"}"}], "difficulty": "easy", "task_id": "translate_001"}}
{"index": 8, "metadata": {"task_description": "Find a restaurant in San Francisco that serves Italian food, has at least 4 stars, and is open now. Return the name, rating, and address.", "answer_schema": {"name": "<restaurant name>", "rating": "<star rating>", "address": "<restaurant address>"}, "tools": [{"type": "function", "function": {"name": "search_restaurants", "description": "Search for restaurants by location and criteria", "parameters": {"type": "object", "properties": {"location": {"type": "string", "description": "City or address"}, "cuisine": {"type": "string", "description": "Type of cuisine"}, "min_rating": {"type": "number", "description": "Minimum star rating"}, "open_now": {"type": "boolean", "description": "Only show currently open restaurants"}}, "required": ["location"]}}}], "expected_answer": {"name": "Trattoria da Vittorio", "rating": 4.5, "address": "123 Columbus Ave, San Francisco, CA"}, "ground_truth_trajectory": [{"tool_name": "search_restaurants", "tool_input": {"location": "San Francisco", "cuisine": "Italian", "min_rating": 4, "open_now": true}, "tool_output": "{\"restaurants\": [{\"name\": \"Trattoria da Vittorio\", \"rating\": 4.5, \"address\": \"123 Columbus Ave, San Francisco, CA\", \"cuisine\": \"Italian\"}]}"}], "difficulty": "easy", "task_id": "restaurant_001"}}
{"index": 9, "metadata": {"task_description": "Book a flight from San Francisco to New York for tomorrow, departing after 9 AM. Find the cheapest option and return the flight number, departure time, and price.", "answer_schema": {"flight_number": "<flight number>", "departure_time": "<departure time>", "price": "<ticket price>"}, "tools": [{"type": "function", "function": {"name": "search_flights", "description": "Search for available flights", "parameters": {"type": "object", "properties": {"origin": {"type": "string", "description": "Departure airport code"}, "destination": {"type": "string", "description": "Arrival airport code"}, "date": {"type": "string", "description": "Travel date (YYYY-MM-DD)"}, "departure_after": {"type": "string", "description": "Minimum departure time (HH:MM)"}}, "required": ["origin", "destination", "date"]}}}, {"type": "function", "function": {"name": "get_date", "description": "Get a date relative to today", "parameters": {"type": "object", "properties": {"offset_days": {"type": "integer", "description": "Number of days from today (0=today, 1=tomorrow, etc.)"}}, "required": ["offset_days"]}}}], "expected_answer": {"flight_number": "UA123", "departure_time": "10:30", "price": 299}, "ground_truth_trajectory": [{"tool_name": "get_date", "tool_input": {"offset_days": 1}, "tool_output": "{\"date\": \"2024-01-16\"}"}, {"tool_name": "search_flights", "tool_input": {"origin": "SFO", "destination": "JFK", "date": "2024-01-16", "departure_after": "09:00"}, "tool_output": "{\"flights\": [{\"flight_number\": \"UA123\", \"departure\": \"10:30\", \"arrival\": \"19:00\", \"price\": 299}, {\"flight_number\": \"AA456\", \"departure\": \"14:00\", \"arrival\": \"22:30\", \"price\": 350}]}"}], "difficulty": "hard", "task_id": "flight_001"}}
