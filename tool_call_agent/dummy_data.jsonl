{"index": 0, "metadata": {"task_description": "What is the current weather in Tokyo?", "answer_schema": {"temperature": "<temperature in degrees>", "condition": "<weather condition>", "humidity": "<humidity percentage>"}, "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get current weather information for a specified city", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "The city name"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit"}}, "required": ["city"]}}}], "expected_answer": {"temperature": 22, "condition": "sunny", "humidity": 65}, "ground_truth_trajectory": [{"tool_name": "get_weather", "tool_input": {"city": "Tokyo", "unit": "celsius"}, "tool_output": "{\"temperature\": 22, \"condition\": \"sunny\", \"humidity\": 65}"}], "difficulty": "easy", "task_id": "weather_001"}}
{"index": 1, "metadata": {"task_description": "Calculate the total price of 3 apples at $1.50 each and 2 oranges at $2.00 each, then apply a 10% discount.", "answer_schema": {"subtotal": "<subtotal before discount>", "discount": "<discount amount>", "total": "<total after discount>"}, "tools": [{"type": "function", "function": {"name": "calculator", "description": "Perform basic arithmetic calculations", "parameters": {"type": "object", "properties": {"expression": {"type": "string", "description": "Mathematical expression to evaluate"}}, "required": ["expression"]}}}], "expected_answer": {"subtotal": 8.5, "discount": 0.85, "total": 7.65}, "ground_truth_trajectory": [{"tool_name": "calculator", "tool_input": {"expression": "3 * 1.50 + 2 * 2.00"}, "tool_output": "{\"result\": 8.5}"}, {"tool_name": "calculator", "tool_input": {"expression": "8.5 * 0.10"}, "tool_output": "{\"result\": 0.85}"}, {"tool_name": "calculator", "tool_input": {"expression": "8.5 - 0.85"}, "tool_output": "{\"result\": 7.65}"}], "difficulty": "medium", "task_id": "calc_001"}}
{"index": 2, "metadata": {"task_description": "Search for the latest news about artificial intelligence and summarize the top 3 headlines.", "answer_schema": {"headlines": "<list of top 3 headlines>", "source": "<source of the news>"}, "tools": [{"type": "function", "function": {"name": "web_search", "description": "Search the web for information", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "Search query"}, "num_results": {"type": "integer", "description": "Number of results to return"}}, "required": ["query"]}}}], "expected_answer": {"headlines": ["OpenAI announces GPT-5", "Google DeepMind achieves breakthrough", "AI regulation bill passes Senate"], "source": "web_search"}, "ground_truth_trajectory": [{"tool_name": "web_search", "tool_input": {"query": "artificial intelligence latest news", "num_results": 5}, "tool_output": "{\"results\": [{\"title\": \"OpenAI announces GPT-5\", \"url\": \"...\"}, {\"title\": \"Google DeepMind achieves breakthrough\", \"url\": \"...\"}, {\"title\": \"AI regulation bill passes Senate\", \"url\": \"...\"}]}"}], "difficulty": "easy", "task_id": "search_001"}}
{"index": 3, "metadata": {"task_description": "Convert 100 USD to EUR and then to JPY. Provide all three currency values.", "answer_schema": {"usd": "<amount in USD>", "eur": "<amount in EUR>", "jpy": "<amount in JPY>"}, "tools": [{"type": "function", "function": {"name": "currency_convert", "description": "Convert between currencies using current exchange rates", "parameters": {"type": "object", "properties": {"amount": {"type": "number", "description": "Amount to convert"}, "from_currency": {"type": "string", "description": "Source currency code"}, "to_currency": {"type": "string", "description": "Target currency code"}}, "required": ["amount", "from_currency", "to_currency"]}}}], "expected_answer": {"usd": 100, "eur": 92.5, "jpy": 15000}, "ground_truth_trajectory": [{"tool_name": "currency_convert", "tool_input": {"amount": 100, "from_currency": "USD", "to_currency": "EUR"}, "tool_output": "{\"converted_amount\": 92.5, \"rate\": 0.925}"}, {"tool_name": "currency_convert", "tool_input": {"amount": 100, "from_currency": "USD", "to_currency": "JPY"}, "tool_output": "{\"converted_amount\": 15000, \"rate\": 150}"}], "difficulty": "medium", "task_id": "currency_001"}}
{"index": 4, "metadata": {"task_description": "Find the distance between New York and Los Angeles, then calculate how long it would take to drive at 60 mph average speed.", "answer_schema": {"distance_miles": "<distance in miles>", "drive_time_hours": "<drive time in hours>"}, "tools": [{"type": "function", "function": {"name": "get_distance", "description": "Get distance between two locations", "parameters": {"type": "object", "properties": {"origin": {"type": "string", "description": "Starting location"}, "destination": {"type": "string", "description": "Ending location"}, "unit": {"type": "string", "enum": ["miles", "kilometers"]}}, "required": ["origin", "destination"]}}}, {"type": "function", "function": {"name": "calculator", "description": "Perform basic arithmetic calculations", "parameters": {"type": "object", "properties": {"expression": {"type": "string", "description": "Mathematical expression to evaluate"}}, "required": ["expression"]}}}], "expected_answer": {"distance_miles": 2790, "drive_time_hours": 46.5}, "ground_truth_trajectory": [{"tool_name": "get_distance", "tool_input": {"origin": "New York", "destination": "Los Angeles", "unit": "miles"}, "tool_output": "{\"distance\": 2790, \"unit\": \"miles\"}"}, {"tool_name": "calculator", "tool_input": {"expression": "2790 / 60"}, "tool_output": "{\"result\": 46.5}"}], "difficulty": "medium", "task_id": "travel_001"}}
{"index": 5, "metadata": {"task_description": "Look up the stock price of Apple (AAPL) and Microsoft (MSFT), then calculate the total value of owning 10 shares of each.", "answer_schema": {"aapl_price": "<Apple stock price>", "msft_price": "<Microsoft stock price>", "total_value": "<total value of 10 shares each>"}, "tools": [{"type": "function", "function": {"name": "get_stock_price", "description": "Get current stock price for a given ticker symbol", "parameters": {"type": "object", "properties": {"symbol": {"type": "string", "description": "Stock ticker symbol"}}, "required": ["symbol"]}}}, {"type": "function", "function": {"name": "calculator", "description": "Perform basic arithmetic calculations", "parameters": {"type": "object", "properties": {"expression": {"type": "string", "description": "Mathematical expression to evaluate"}}, "required": ["expression"]}}}], "expected_answer": {"aapl_price": 178.5, "msft_price": 420.3, "total_value": 5988}, "ground_truth_trajectory": [{"tool_name": "get_stock_price", "tool_input": {"symbol": "AAPL"}, "tool_output": "{\"price\": 178.5, \"currency\": \"USD\"}"}, {"tool_name": "get_stock_price", "tool_input": {"symbol": "MSFT"}, "tool_output": "{\"price\": 420.3, \"currency\": \"USD\"}"}, {"tool_name": "calculator", "tool_input": {"expression": "10 * 178.5 + 10 * 420.3"}, "tool_output": "{\"result\": 5988}"}], "difficulty": "medium", "task_id": "stock_001"}}
